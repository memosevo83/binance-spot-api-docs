client = Client(API_KEY, API_SECRET) client.API_URL = TESTNET_URL

symbol = 'FETUSDT' timeframe = '1h' quantity = 50  # USDT cinsinden pozisyon büyüklüğü

Göstergeler hesaplama

def get_klines(symbol, interval, limit=100): klines = client.get_klines(symbol=symbol, interval=interval, limit=limit) df = pd.DataFrame(klines, columns=[ 'timestamp', 'open', 'high', 'low', 'close', 'volume', 'close_time', 'quote_asset_volume', 'number_of_trades', 'taker_buy_base_vol', 'taker_buy_quote_vol', 'ignore']) df['close'] = df['close'].astype(float) df['volume'] = df['volume'].astype(float) return df

def calculate_indicators(df): df['EMA20'] = df['close'].ewm(span=20).mean() df['EMA50'] = df['close'].ewm(span=50).mean() df['MACD'] = df['close'].ewm(span=12).mean() - df['close'].ewm(span=26).mean() df['MACD_signal'] = df['MACD'].ewm(span=9).mean() df['RSI'] = compute_rsi(df['close'], 14) return df

def compute_rsi(series, period): delta = series.diff() gain = (delta.where(delta > 0, 0)).rolling(window=period).mean() loss = (-delta.where(delta < 0, 0)).rolling(window=period).mean() rs = gain / loss return 100 - (100 / (1 + rs))

def check_signals(df): last = df.iloc[-1] cond_long = last['EMA20'] > last['EMA50'] and last['MACD'] > last['MACD_signal'] and last['RSI'] < 65 cond_short = last['EMA20'] < last['EMA50'] and last['MACD'] < last['MACD_signal'] and last['RSI'] > 35 return cond_long, cond_short

def get_price(symbol): ticker = client.get_symbol_ticker(symbol=symbol) return float(ticker['price'])

def execute_trade(side, symbol, usdt_amount): price = get_price(symbol) quantity = round(usdt_amount / price, 2) try: order = client.create_order( symbol=symbol, side=SIDE_BUY if side == 'BUY' else SIDE_SELL, type=ORDER_TYPE_MARKET, quantity=quantity ) print(f"{side} order executed at {price} for {quantity} {symbol}") return order except BinanceAPIException as e: print(f"Order Error: {e}") return None

Bot Döngüsü

while True: df = get_klines(symbol, timeframe) df = calculate_indicators(df) long_signal, short_signal = check_signals(df)

if long_signal:
    execute_trade('BUY', symbol, quantity)
elif short_signal:
    execute_trade('SELL', symbol, quantity)
else:
    print("No signal.")

time.sleep(3600)  # 1 saat bekle

